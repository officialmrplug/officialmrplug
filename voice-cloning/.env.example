# Copy to .env and edit.  .env is gitignored - it never gets committed.
#   cp .env.example .env
#
# Every value here is optional; each falls back to the default shown.
# Command-line flags always win over these.

# --- Voice -----------------------------------------------------------------
# Path to the reference clip. Leave blank to auto-use the only clip in VOICES_DIR,
# so you can just drop a file in voices/ and never edit this.
VOICE_REF=
VOICES_DIR=voices

# --- What to say -----------------------------------------------------------
VOICE_TEXT=Hello! This is my cloned voice, generated on my own machine.
VOICE_OUTPUT=output.wav

# --- Hardware --------------------------------------------------------------
# auto | cuda | mps | cpu
VOICE_DEVICE=auto

# --- Model -----------------------------------------------------------------
# true = 350M Turbo model (less VRAM, ignores exaggeration/cfg_weight)
VOICE_TURBO=false
# ISO code for the multilingual model (ar da de el en es fi fr he hi it ja ko
# ms nl no pl pt ru sv sw tr zh). Leave blank for the English-only base model.
VOICE_LANGUAGE=

# --- Tuning ----------------------------------------------------------------
VOICE_EXAGGERATION=0.5
VOICE_CFG_WEIGHT=0.5
VOICE_TEMPERATURE=0.8
VOICE_MAX_CHARS=300
VOICE_GAP=0.15
# Set to a fixed integer to make output reproducible.
VOICE_SEED=

# --- Local API server (server.py) ------------------------------------------
SERVER_HOST=127.0.0.1
SERVER_PORT=8000
# Optional shared secret. If set, requests must send:  Authorization: Bearer <key>
# Leave blank for no auth (fine while bound to 127.0.0.1).
SERVER_API_KEY=

# --- Model weight cache ----------------------------------------------------
# Where the ~2GB download is stored. Blank = ~/.cache/huggingface
HF_HOME=
